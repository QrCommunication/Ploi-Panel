<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout inflated by the launcher with framework widgets: AppCompat's
     app:drawableStartCompat is unavailable here, so android:drawableStart is the correct attribute. -->
<!-- Single-server widget: name, worded status, one gauge per selected percentage, load as text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/widget_mark"
            tools:ignore="UseCompatTextViewDrawableXml"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_server_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_metric_cpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_metric_cpu_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_metric_cpu_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/widget_metric_cpu_ok"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_ok"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_cpu_warn"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_warn"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_cpu_crit"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_crit"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_metric_ram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_metric_ram_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_metric_ram_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/widget_metric_ram_ok"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_ok"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_ram_warn"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_warn"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_ram_crit"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_crit"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_metric_disk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_metric_disk_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_metric_disk_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/widget_metric_disk_ok"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_ok"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_disk_warn"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_warn"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/widget_metric_disk_crit"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_gauge_crit"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_load"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
